# Local development only. Replace with managed secrets in deployed environments.
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Local Docker Compose PostgreSQL credentials; never use these in production.
POSTGRES_DB=threatsentinel
POSTGRES_USER=threatsentinel
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://threatsentinel:local-development-only@localhost:5432/threatsentinel

# The JWT verifier, reusable authentication dependency, and protected scan routes are
# implemented. Liveness/readiness remain available without authentication settings; protected
# scan requests fail closed with 503. When configuring a trusted issuer/JWKS integration,
# supply all four core settings together; partial configuration is invalid. The .invalid host
# below is a safe placeholder.
# AUTH_EXPECTED_ISSUER=https://identity.example.invalid/
# AUTH_EXPECTED_AUDIENCE=threat-sentinel-api
# AUTH_TRUSTED_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
# AUTH_ALLOWED_JWT_ALGORITHMS=["RS256"]
#
# Optional verifier bounds:
# AUTH_CLOCK_SKEW_SECONDS=30
# AUTH_JWKS_CACHE_TTL_SECONDS=300
# AUTH_JWKS_CACHE_MAX_ENTRIES=16

# Best-effort in-process limits for sensitive mutation endpoints. A shared store is required
# for distributed production deployments.
# SENSITIVE_RATE_LIMIT_REQUESTS=30
# SENSITIVE_RATE_LIMIT_WINDOW_SECONDS=60
