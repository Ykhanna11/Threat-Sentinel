# Local development only. Replace with managed secrets in deployed environments.
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Local Docker Compose PostgreSQL credentials; never use these in production.
POSTGRES_DB=threatsentinel
POSTGRES_USER=threatsentinel
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://threatsentinel:local-development-only@localhost:5432/threatsentinel
